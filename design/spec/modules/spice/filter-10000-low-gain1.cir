Filter response: vendor OTA, ideal opamps; fc command 10000, damping feedback 0
.param ibfreq=0.000245927799914 ibres=0 ibdry=0.000403225806452
.include "design/spec/modules/spice/filter-core-vendor.inc"
.control
set wr_singlescale
set wr_vecnames
op
print v(BP_INT) v(LP_INT) v(HP_CORE)
ac dec 100 2 200k
wrdata .circuit-cache/filter-spice/filter-10000-low-gain1.txt db(v(LP_TIP)) db(v(BP_TIP)) db(v(HP_TIP)) db(v(OUT_TIP))
quit
.endc
.end
