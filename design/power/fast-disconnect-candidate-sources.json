      "locators": [
        {
          "physical_pdf_page_index": 0,
          "printed_page_label": "1",
          "locator": "Product/ordering and limiting values",
          "normalized_extract": "BSS138N, PG-SOT-23, H6327 3000/reel; VDS 60 V, VGS +/-20 V; ID 230 mA at 25 C, 180 mA at 70 C."
        },
        {
          "physical_pdf_page_index": 1,
          "printed_page_label": "2",
          "locator": "Static characteristics",
          "normalized_extract": "25 C: VGSth 0.6..1.4 V at ID=26 uA; Ron<=4 ohm at VGS=4.5 V, ID=30 mA. Off current<=0.1 uA at VGS=0,VDS=60 V; <=5 uA at 150 C."
        },
        {
          "physical_pdf_page_index": 2,
          "printed_page_label": "3",
          "locator": "Dynamic/gate charge",
          "normalized_extract": "At 25 C: Qg<=1.4 nC for VGS 0..10 V, VDD=48 V, ID=230 mA; Ciss<=41 pF at VGS=0,VDS=25 V,1MHz. td(off)<=10 ns,tf<=12.3 ns at VDD=30 V,VGS=10 V,ID=230 mA,RG=6 ohm. These test trajectories are not the proposed passive bleed."
        },
        {
          "physical_pdf_page_index": 2,
          "printed_page_label": "3",
          "locator": "Reverse diode",
          "normalized_extract": "VSD<=1.2 V at IF=230 mA,VGS=0,25 C. The diagnostic 0.7 V diode drop is an assumption."
        }
      ],
      "identity": {
        "supplier": "DigiKey",
        "supplier_order_code": "BSS138NH6327XTSA2CT-ND",
