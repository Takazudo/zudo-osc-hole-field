index e0a13053..295330c3 100644
--- a/design/spec/modules/power.py
+++ b/design/spec/modules/power.py
@@ -12,7 +12,12 @@ from design.spec.cells._builder import load_symbol
 
 RAILS = ('+12V', '-12V', '+5V')
 RAW = ('+12V_IN', '-12V_IN', '+5V_IN')
-GLOBAL_NETS = (*RAILS, *RAW, 'AGND')
+# P59-C (#59, UNADOPTED): one buffered permit conductor per module family.
+PERMIT_BRANCHES = ('envelope', 'filter', 'manual_ab', 'mix4_vca', 'mix5', 'mult', 'offset', 'oscillator', 'sample_hold', 'wavefolder')
+GLOBAL_NETS = (*RAILS, *RAW, 'AGND', *('ENABLE_OK_' + b.upper() for b in PERMIT_BRANCHES))
+# Candidate monitor parts excluded from the master: Q101/R122..R124 are the
+# isolated draft's dummy sink load, replaced here by the branch buffers.
+PERMIT_DUMMY = ('Q101', 'R122', 'R123', 'R124')
 IDENTITIES = {
     'OSC_EXT_INLET_R1': ('CN', 'Logical eight-contact inlet, NOT SELECTED'),
     'OSC_EXT_BOUNDARY_R1': ('XB', 'Unimplemented source/protection requirement'),
@@ -76,7 +81,49 @@ def family() -> Family:
             value=rail, island='POWER_PROBE')
     add('TestPoint', 'TP_GND', {'1': 'AGND'}, 50.8, 279.4,
         value='AGND', island='POWER_PROBE')
-    return Family('01_power_interfaces', tuple(parts), global_nets=GLOBAL_NETS)
+    parts += permit_parts()
+    return Family('01_power_interfaces', tuple(parts), global_nets=GLOBAL_NETS, paper='A1')
+
+
+def permit_parts() -> list[Part]:
+    """Monitor/permit candidate (design/power/monitor-permit-draft.json) on the master power sheet.
+
+    VN is the -12V load rail. PERMIT_Q (SN74LVC1G74 Q, high = permit) feeds one
+    SN74LVC1G17 buffer per family branch. Nothing here is selected or qualified.
+    """
+    from dataclasses import replace
+    from scripts.schgen.generate_monitor_permit import specification as permit_specification
+    (draft,), _, _ = permit_specification()
+    rename = {'VN': '-12V'}
+    shift = {'U': 0, 'R': 10, 'C': 10}
+    out: list[Part] = []
+    template_u = next(p for p in draft.parts if p.key.startswith('U104.'))
+    template_c = next(p for p in draft.parts if p.key.startswith('C101.'))
+    for p in draft.parts:
+        ref = p.key.split('.')[0]
+        if ref in PERMIT_DUMMY or p.prefix == 'J':
+            continue
+        pins = {k: rename.get(v, v) for k, v in p.pins.items()}
+        n = len(out)
+        out.append(replace(p, key='PERMIT_' + p.key, ordinal=p.ordinal + shift[p.prefix], pins=pins,
+                           page=1, x=50.8 + (n % 8) * 63.5, y=330.2 + (n // 8) * 38.1,
+                           attributes={**p.attributes, 'Island': 'POWER_PERMIT',
+                                       'Implementation': 'Unvalidated physical draft (P59-C, unadopted)'}))
+    for number, branch in enumerate(PERMIT_BRANCHES, 1):
+        net = 'ENABLE_OK_' + branch.upper()
+        n = len(out)
+        out.append(replace(template_u, key=f'PERMIT_BUF_{number}.1', ordinal=6 + number,
+                           pins={'1': None, '2': 'PERMIT_Q', '3': 'AGND', '4': net, '5': '+5V'},
+                           page=1, x=50.8 + (n % 8) * 63.5, y=330.2 + (n // 8) * 38.1,
+                           attributes={**template_u.attributes, 'Island': 'POWER_PERMIT',
+                                       'Role': 'UNSELECTED DRAFT: ' + branch + ' ENABLE_OK branch buffer'}))
+        n = len(out)
+        out.append(replace(template_c, key=f'PERMIT_BUF_C{number}.1', ordinal=20 + number,
+                           pins={'1': '+5V', '2': 'AGND'},
+                           page=1, x=50.8 + (n % 8) * 63.5, y=330.2 + (n // 8) * 38.1,
+                           attributes={**template_c.attributes, 'Island': 'POWER_PERMIT',
+                                       'Role': 'UNSELECTED DRAFT: branch buffer bypass'}))
+    return out
 
 
