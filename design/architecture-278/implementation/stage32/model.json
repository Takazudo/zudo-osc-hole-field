  "procedure": {
    "assembly": [
      "Bench: dress each cable as a tight round bundle (sleeve or wrap) and crimp/insert per JST tooling (vendor, Q-H01).",
      "Fit the jack carrier and A01-jack; fit the middle carrier with R1/R2 saddles snapped into notches N1/N2 (legs into the flank grooves).",
      "Mate J-SIG:local and J-PWR:local from the rear (+z) and form the free local loops left of x 232.",
      "Lay each bundle in its saddle and close the strap latch (rail top exposed, A01-middle not yet fitted).",
      "Bench: mate the J-SIG/J-PWR middle housings onto the A01-middle headers; before the rear (core) carrier is fitted, lower A01-middle onto its spacers along -z with the hooks hanging below it, feeding slack back through the guides; fit the four screws, then the rear carrier.",
      "Fit the core onto the DIN connector and connect K-PWR last."
    ],
    "harness_replacement": [
      "Requires removal of A01-middle (core removed first) or front access through RV-ACCESS; open the strap latches R1/R2 with a flat tool from +x."
    ],
    "service_core": [
      "Power off and discharge; remove the rear cover.",
      "Disconnect K-PWR; release the four core screws; support both handles and withdraw the core 40 mm along +z. J-SIG and J-PWR are not touched."
    ],
    "service_middle_connectors": [
      "Power off. Remove the front panel; front access to the middle headers needs the corridor in reservation RV-ACCESS (owner decision).",
      "Press the GH latch with a flat tool, hold the bundle and pull within 15 degrees of -z until the housing is free; the cable slides back through R1/R2 from the local loop.",
      "Refit: push the housing on until it latches; draw the slack back to the local loop."
    ]
  },
