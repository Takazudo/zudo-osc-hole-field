# Dependencies and build output
node_modules
doc/dist
doc/.zfb
doc/.zfb-build/

# Runtime caches (never committed; generated MDX and preflight ARE committed)
.zudo-doc/
.circuit-cache/
boards/*/routing-work/
boards/*/reports/*.svg

# zudo-doc's own generated Claude Code resource docs (regenerated on every
# build/check/dev from .claude/ — same convention zudo-doc itself uses)
doc/src/content/docs/claude/
doc/src/content/docs/claude-md/
doc/src/content/docs/claude-commands/
doc/src/content/docs/claude-skills/
doc/src/content/docs/claude-agents/

# macOS
.DS_Store

# Local Wrangler state
doc/.wrangler/

# Isolated development worktrees
worktrees/

# Python bytecode caches
__pycache__/

# KiCad working files
*-backups/
fp-info-cache
*.kicad_prl
*.lck
_autosave-*
*-bak

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
