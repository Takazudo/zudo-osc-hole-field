--- a/scripts/kicad/run.sh
+++ b/scripts/kicad/run.sh
@@ -52,7 +52,20 @@
   local docker_bin=$1
   local home_dir=$2
   shift 2
-  "$docker_bin" run --rm --platform linux/amd64 --network none \
+  local resource_args=()
+  local bounded_command=()
+  if [[ -n ${EPIC242_NATIVE_SLICE:-} ]]; then
+    [[ $EPIC242_NATIVE_SLICE =~ ^epic242-[a-z0-9-]+\.slice$ ]] || return 1
+    [[ ${EPIC242_NATIVE_WORKER:-} =~ ^[a-z0-9][a-z0-9-]{0,60}$ ]] || return 1
+    [[ ${EPIC242_NATIVE_DEADLINE:-} =~ ^[0-9]+$ ]] || return 1
+    local remaining=$((EPIC242_NATIVE_DEADLINE - $(date +%s)))
+    ((remaining > 0 && remaining <= 2580)) || return 1
+    bounded_command=(timeout --signal=TERM --kill-after=5s "${remaining}s")
+    resource_args=(--memory=6442450944 --memory-swap=6442450944
+      --cgroup-parent="$EPIC242_NATIVE_SLICE"
+      --label "epic242.native.worker=$EPIC242_NATIVE_WORKER")
+  fi
+  "$docker_bin" run "${resource_args[@]}" --rm --platform linux/amd64 --network none \
     --user "$(id -u):$(id -g)" \
     --volume "$repo_root:/work" \
     --volume "$home_dir:/tmp/kicad-home" \
@@ -65,7 +78,7 @@
     --entrypoint /bin/sh \
     "$KICAD_IMAGE" \
     -c 'mkdir -p "$HOME/.config" "$HOME/.cache" "$HOME/.local/share" "$XDG_RUNTIME_DIR"; chmod 700 "$XDG_RUNTIME_DIR"; exec "$@"' \
-    kicad-oracle "$@"
+    kicad-oracle "${bounded_command[@]}" "$@"
 }
 
 run_with_docker() {
@@ -88,6 +101,15 @@
   run_docker "$docker_bin" "$home_dir" "$@"
 }
 
+if [[ -n ${EPIC242_NATIVE_SLICE:-} && -n ${KICAD_CLI_BIN:-} ]]; then
+  printf 'Bounded Epic242 mode refuses native-binary fallback.\n' >&2
+  exit 1
+fi
+if [[ -n ${EPIC242_NATIVE_SLICE:-} ]] && ! command -v docker >/dev/null; then
+  printf 'Bounded Epic242 mode requires local Docker.\n' >&2
+  exit 1
+fi
+
 if [[ -n ${KICAD_CLI_BIN:-} ]]; then
   if [[ ! -x $KICAD_CLI_BIN ]]; then
     printf 'KICAD_CLI_BIN is set but is not executable: %s\n' "$KICAD_CLI_BIN" >&2
